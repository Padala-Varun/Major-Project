# Copy to backend/.env and fill in. Never commit the real .env.

# Required — LLM + embeddings (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Optional — chat model. It must have a non-zero rate limit on your Mistral plan;
# on the free tier codestral-latest does, while mistral-medium/large may not.
LLM_MODEL=codestral-latest

# Required for the Fix flow (fetch issues, push branches, open PRs).
# Classic token with `public_repo` scope (or `repo` for private repos).
GITHUB_TOKEN=

# Optional — auto-reload the API server on code changes during development
DEV_RELOAD=false
